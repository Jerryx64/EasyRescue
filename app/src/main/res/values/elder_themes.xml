<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ElderHomeTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#F3F8F7</item>
        <item name="android:colorAccent">#126C72</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F3F8F7</item>
